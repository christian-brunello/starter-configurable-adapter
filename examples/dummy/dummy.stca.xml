<?xml version="1.0" encoding="UTF-8"?>
<!--
  STCA:Dummy - temporary plugin for exercising the common HTTP API.

  Run from the build tree (after make), for example:

    LD_LIBRARY_PATH=lib/.libs \
    src/starter-configurable-adapter \
      -c examples/dummy/dummy.stca.xml \
      -p plugins/dummy/.libs

  Then:

    curl http://127.0.0.1:8080/health
    curl http://127.0.0.1:8080/data
    curl -X PUT http://127.0.0.1:8080/data/setpoint \
      -d '22.5' -H 'Content-Type: application/json'
    # temperature is read-only and returns 403
-->
<stca version="1">
  <global>
    <listen-address>127.0.0.1</listen-address>
    <listen-port>8080</listen-port>
    <adapter-name>STCA:Dummy</adapter-name>
  </global>
  <plugin name="dummy">
    <interval-ms>5000</interval-ms>
  </plugin>
</stca>
