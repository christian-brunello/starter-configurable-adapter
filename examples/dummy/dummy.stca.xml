<?xml version="1.0" encoding="UTF-8"?>
<!--
  STCA:Dummy - temporary plugin for exercising the D-Bus API (and optional HTTP).

  Run from the build tree (after make), for example:

    LD_LIBRARY_PATH=lib/.libs \
    src/starter-configurable-adapter \
      -c examples/dummy/dummy.stca.xml \
      -p plugins/dummy/.libs

  D-Bus (default): peer TCP at listen-address:listen-port
    interface org.starter.Adapter on /org/starter/adapter

  Optional HTTP: enable in XML (enable-http + http-listen-port)
  or pass CLI flags enable-http and http-port.

    curl http://127.0.0.1:18081/health
    curl http://127.0.0.1:18081/data
-->
<stca version="1">
  <global>
    <listen-address>127.0.0.1</listen-address>
    <listen-port>18080</listen-port>
    <adapter-name>STCA:Dummy</adapter-name>
  </global>
  <plugin name="dummy">
    <interval-ms>5000</interval-ms>
  </plugin>
</stca>
