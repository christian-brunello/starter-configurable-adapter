Description: STARTER Configurable Adapter library (plugin API)
Version: @PACKAGE_VERSION@
Requires: glib-2.0 gobject-2.0 gio-2.0 gmodule-2.0 libxml-2.0
Cflags: -I${includedir}
Libs: -L${libdir} -lstarter-configurable-adapter
